{
  "schema": 1,
  "note": "风险分层评测用例集（S-06）。label_source=synthetic 表示标签由本项目人工规则/合成构造，不是领域人标；阈值只允许在 split=calibration 上选定，split=frozen 只评估不调参。",
  "cases": [
    {"id": "cal-emg-leak", "split": "calibration", "label_source": "synthetic",
     "message": "液氨钢瓶泄漏正在扩散，已经有人中毒",
     "expect": {"escalated": true, "not_escalated_from_clarify": true}},
    {"id": "cal-emg-fire", "split": "calibration", "label_source": "synthetic",
     "message": "车间着火了怎么回事",
     "expect": {"escalated": true}},
    {"id": "cal-emg-negation", "split": "calibration", "label_source": "synthetic",
     "message": "没有泄漏，只是例行巡检",
     "expect": {"escalated": false}},
    {"id": "cal-cite-permit-validity", "split": "calibration", "label_source": "synthetic",
     "message": "动火作业票的有效期是怎么规定的",
     "expect": {"min_citations": 1}},
    {"id": "cal-cite-confined-detect", "split": "calibration", "label_source": "synthetic",
     "message": "受限空间作业前要做哪些气体检测",
     "expect": {"min_citations": 1}},
    {"id": "cal-tool-ethanol-cas", "split": "calibration", "label_source": "synthetic",
     "message": "乙醇的 CAS 号是多少",
     "expect": {"require_tools": ["msds_lookup"]}},
    {"id": "cal-tool-cas-lookup", "split": "calibration", "label_source": "synthetic",
     "message": "64-17-5 的泄漏应急处理要求是什么",
     "expect": {"require_tools": ["msds_lookup"]}},
    {"id": "cal-gap-unknown-cas", "split": "calibration", "label_source": "synthetic",
     "message": "9999-99-9 的安全要求是什么",
     "expect": {"require_substrings": ["缺口"]}},
    {"id": "cal-greeting", "split": "calibration", "label_source": "synthetic",
     "message": "你好",
     "expect": {"escalated": false}},
    {"id": "cal-irrelevant", "split": "calibration", "label_source": "synthetic",
     "message": "推荐几首歌",
     "expect": {"escalated": false}},

    {"id": "frz-emg-spread", "split": "frozen", "label_source": "synthetic",
     "message": "液氯钢瓶刺漏并且正在蔓延，止不住",
     "expect": {"escalated": true, "not_escalated_from_clarify": true}},
    {"id": "frz-emg-explosion", "split": "frozen", "label_source": "synthetic",
     "message": "反应釜爆炸了，有人受伤",
     "expect": {"escalated": true}},
    {"id": "frz-drill-precision", "split": "frozen", "label_source": "synthetic",
     "message": "培训课件里讲的火灾演练怎么写，泄漏案例怎么复盘",
     "expect": {"escalated": false}},
    {"id": "frz-cite-hazard-frequency", "split": "frozen", "label_source": "synthetic",
     "message": "隐患排查的频次要求是什么",
     "expect": {"min_citations": 1}},
    {"id": "frz-tool-methanol", "split": "frozen", "label_source": "synthetic",
     "message": "甲醇泄漏了怎么处置",
     "expect": {"require_tools": ["msds_lookup"]}},
    {"id": "frz-cite-ledger-scheme", "split": "frozen", "label_source": "synthetic",
     "message": "隐患排查治理制度要点有哪些",
     "expect": {"min_citations": 1}}
  ]
}
