# SafetyMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=SafetyMind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=safetymind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_KB_PERSIST_DIRECTORY=./data/kb_chroma

# ── 本地模型缓存（BGE 嵌入）──────────────────────────────────────────────────
# 默认下载/缓存位置；不设置时 HF 会写 C 盘用户缓存（数百 MB），强烈建议指到数据盘
HF_HOME=D:/hf_cache
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# 转人工值班电话（用户端"转人工"按钮直拨；留空则前端仅提供对话内转人工）
ESCALATION_PHONE=13800000000

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
SAFETYMIND_SKILLS_DIR=./skills
SAFETYMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true

# ── 审计 / 值班通知 / 工单（SQLite 单文件，管理端点需 X-Admin-Token 头）──
AUDIT_ENABLED=1
AUDIT_DB_PATH=./data/audit.db
# 值班群机器人 webhook（企业微信/钉钉/飞书通用文本格式）；留空=仅落库不推送
ESCALATION_WEBHOOK_URL=
# 管理令牌：配置后 /audit /upgrades /tickets 等管理端点需带 X-Admin-Token 头；留空=管理端点锁定
# 网络部署必须设置强随机值（勿用任何公开示例值）；留空=管理端点锁定
# 公网访问令牌：设置后所有业务端点要求请求头 X-Access-Token（发给使用者的口令）；留空=不启用
ACCESS_TOKEN=
ADMIN_TOKEN=
